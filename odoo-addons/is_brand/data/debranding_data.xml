<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- اسم التطبيق في المتصفح وعند التثبيت كتطبيق (PWA) -->
        <record id="param_web_app_name" model="ir.config_parameter">
            <field name="key">web.web_app_name</field>
            <field name="value">نظام إبراهيم سعود</field>
        </record>

        <!-- منع رسائل أودو الترويجية داخل النظام -->
        <record id="param_disable_promo" model="ir.config_parameter">
            <field name="key">database.enable_upgrade_promotion</field>
            <field name="value">False</field>
        </record>

    </data>
</odoo>

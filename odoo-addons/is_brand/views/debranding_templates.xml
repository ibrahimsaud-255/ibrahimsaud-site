<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        إزالة كل ظهور لعلامة أودو من الواجهة.
        ملاحظة رخصية: LGPLv3 لا تشترط ذكر أودو في الواجهة، وإشعارات
        حقوق النشر داخل ملفات الكود الأصلية تبقى كما هي دون تعديل.
    -->

    <!-- ١) صفحة الدخول: حذف «مشغّل بواسطة أودو» -->
    <template id="login_layout_debrand" inherit_id="web.login_layout" name="صفحة دخول بلا علامة أودو">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <span class="text-muted">نظام إبراهيم سعود</span>
        </xpath>
    </template>

    <!-- ٢) تذييل الصفحات العامة: حذف شعار أودو الترويجي -->
    <template id="brand_promotion_debrand" inherit_id="web.brand_promotion" name="تذييل بلا علامة أودو">
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace">
            <div class="o_brand_promotion text-muted">
                <span>نظام إبراهيم سعود</span>
            </div>
        </xpath>
    </template>

    <!-- ٣) الأيقونة المفضّلة: شعارك بدل أيقونة أودو -->
    <template id="layout_favicon" inherit_id="web.layout" name="أيقونة إبراهيم سعود">
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="t-att-href">x_icon or '/is_brand/static/src/img/logo.png'</attribute>
        </xpath>
    </template>

</odoo>

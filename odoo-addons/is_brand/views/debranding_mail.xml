<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- إزالة «Powered by Odoo» من تذييل الرسائل البريدية الصادرة -->

    <template id="mail_layout_debrand" inherit_id="mail.mail_notification_layout" name="بريد بلا علامة أودو">
        <!-- القالب فيه أكثر من div بـ show_footer؛ نستهدف تذييل «Powered by» تحديداً -->
        <xpath expr="//div[@t-if='show_footer'][@style='color: #555555; font-size:11px;']" position="replace">
            <div t-if="show_footer" style="color: #555555; font-size:11px;">
                <span t-if="show_unfollow" id="mail_unfollow">
                    <a href="/mail/unfollow" style="text-decoration:none; color:#555555;">إلغاء المتابعة</a>
                </span>
            </div>
        </xpath>
    </template>

    <template id="mail_layout_light_debrand" inherit_id="mail.mail_notification_light" name="بريد مبسّط بلا علامة أودو">
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <span/>
        </xpath>
    </template>

</odoo>

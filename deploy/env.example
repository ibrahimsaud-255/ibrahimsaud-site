# انسخ هذا الملف باسم .env على الخادم وعبّي القيم
# (ملف .env مستثنى من git — لا يُرفع أبداً)

# ===== Supabase =====
# من Supabase ← Project Settings ← Database ← Connection string ← Session pooler
# مثال المضيف: aws-0-eu-central-1.pooler.supabase.com
SUPABASE_HOST=
SUPABASE_PORT=5432

# مهم: مع الـ pooler اسم المستخدم يكون  <الدور>.<معرّف المشروع>
# مثال: odoo_app.rrerwhhxrjyzmnnjsfev
SUPABASE_USER=

# كلمة مرور الدور odoo_app التي وضعتها في supabase-prepare.sql
SUPABASE_PASSWORD=

SUPABASE_DB=postgres

# عدد الاتصالات (الباقة المجانية محدودة — لا ترفعه)
DB_MAXCONN=8

# ===== الخادم =====
# النطاق الذي وجّهته لعنوان الخادم
DOMAIN=erp.ibrahimsaud.com
ADMIN_EMAIL=ibrahimsaud25@gmail.com

# عدد العمّال (4 مناسب لخادم Oracle المجاني ذي الـ4 أنوية)
WORKERS=4

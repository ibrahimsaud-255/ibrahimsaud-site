# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# ملف أسرار النشر المؤقت — لا يُرفع أبداً
.deploy-secrets
.webhook-secret.txt

# ملفات Supabase CLI المؤقتة
supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev scratch / editor junk
.fuse_hidden*
outputs/
public/**/.fuse_hidden*

# مصادر أصلية كبيرة (لا تُرفع) — الخط والخلفيات الأصلية
/خط النظام/
/خلفيات النظام/
__pycache__/

# سورس أودو (١.١ جيجا) وبياناته المحلية — لا يُرفع مع الموقع
/odoo-19.0/
/odoo-data/
/odoo.conf
/odoo-venv/

# ملفات تصميم أصلية (لا تُرفع — كبيرة الحجم)
/Artboard*.png
/صورتي*.png

# أسرار نظام أودو المحلي
/.odoo-secrets

# ملف بيانات النشر (يحتوي كلمات مرور)
deploy/.env
